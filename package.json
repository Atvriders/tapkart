{
  "name": "tapkart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:server": "npm run build -w @tapkart/web && npm run build -w @tapkart/server",
    "start": "node packages/server/dist/main.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "ws": "8.21.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-arm64": "0.28.2",
    "@rollup/rollup-linux-arm64-gnu": "4.62.4",
    "@rollup/rollup-linux-arm64-musl": "4.62.4"
  }
}
